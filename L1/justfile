# L1 — the GitOps platform. Run from the L1 directory.
#
# Every recipe reads the kubeconfig out of the L0 contract, so there is no
# ambient `kubectl` context to get wrong.

set shell := ["bash", "-uc"]

argocd_ns := "argocd"
l0_env    := env_var_or_default("L0_ENV", "local")
l1_env    := env_var_or_default("L1_ENV", "dev-local")

# The AppProject that marks an Application as L1's. It is the layer boundary:
# L2's Applications live in project `maal` and are not L1's to pass judgement
# on. Used by `drift` and `verify` — see the note above `drift`.
#
# The project, not the platform.maal/stage label: that label is applied by the
# component appsets only, so it misses `argocd` and `platform-root` — the two
# whose failure matters most.
project   := "platform"
contract  := justfile_directory() / ".." / "L0" / l0_env / "contract.json"

_default:
    @just --list --unsorted

# Resolve the kubeconfig from the L0 contract; fail clearly if L0 is not up.
_kubeconfig:
    @test -f {{contract}} || { echo "!! L0 '{{l0_env}}' is not up — run: cd ../L0 && just {{l0_env}}-up" >&2; exit 1; }
    @jq -er .kubeconfig {{contract}}

# ─── lifecycle ─────────────────────────────────────────────────────────────

# Bootstrap Argo (pinned) + apply the app-of-apps root
up:
    ./bootstrap/up.sh

# Remove the platform + Argo, keeping the cluster (destructive; prompts)
down:
    ./bootstrap/down.sh

# ─── inspection ────────────────────────────────────────────────────────────

# Applications with sync + health status
apps:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} get applications -o wide

# Applications + platform pods across every namespace L1 owns
status:
    #!/usr/bin/env bash
    set -euo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    kubectl -n {{argocd_ns}} get applicationsets -o wide 2>/dev/null || true
    echo
    kubectl -n {{argocd_ns}} get applications -o wide
    for ns in istio-system cert-manager external-secrets; do
        echo "--- $ns ---"
        kubectl -n "$ns" get pods 2>/dev/null || echo "  (namespace not created yet)"
    done

# Follow Application health until you stop it — the missing feedback loop
watch:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} get applications -o wide -w

# Anything not Synced+Healthy right now. Exits non-zero if so — usable in CI.
#
# SCOPED TO L1's OWN PROJECT. Argo keeps every layer's Applications in one
# namespace, so an unfiltered query answers "is anything in this cluster
# broken", not "is L1 broken". A half-finished L2 then makes L1 report itself
# as not converged while all seven of its components are green — which is a
# lie in CI, and the kind that trains people to ignore the check.
drift:
    #!/usr/bin/env bash
    set -uo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    bad=$(kubectl -n {{argocd_ns}} get applications \
        -o jsonpath='{range .items[?(@.spec.project=="{{project}}")]}{.metadata.name}{"\t"}{.status.sync.status}{"\t"}{.status.health.status}{"\n"}{end}' \
        | awk '$2 != "Synced" || $3 != "Healthy"')
    if [ -n "$bad" ]; then
        echo "!! not converged:"; echo "$bad"; exit 1
    fi
    echo ">> all {{project}} Applications Synced + Healthy"

# `drift` asks only "is every Application Synced+Healthy". That is necessary,
# not sufficient, and it FAILS OPEN: an ApplicationSet whose generator errored
# produces zero Applications, and zero Applications are all trivially
# Synced+Healthy. `drift` reports success on an empty cluster.
#
# So this checks, in dependency order:
#
#   1. the L0 contract still holds       L1 is written against exactly it
#   2. Argo's own workloads are ready    nothing below means anything otherwise
#   3. the generators produced params    where a template error hides
#   4. the expected component matrix     the fail-open case above
#   5. every Application Synced+Healthy  what `drift` covers
#   6. the CRDs L2 will demand           so a missing capability surfaces here,
#                                        not as "no matches for kind" one layer
#                                        up — same four L2/bootstrap checks
#
# Does L1 deliver what it promises? Exits non-zero if not — usable in CI.
verify:
    #!/usr/bin/env bash
    set -uo pipefail
    export KUBECONFIG="$(just _kubeconfig)"
    fail=0
    ok(){  printf '  ok    %s\n' "$*"; }
    no(){  printf '  FAIL  %s\n' "$*"; fail=1; }

    echo "── 1. L0 contract ────────────────────────────────"
    sc="$(jq -r .storageClass {{contract}} 2>/dev/null || echo '')"
    kubectl get nodes >/dev/null 2>&1 && ok "cluster reachable" || no "cluster unreachable"
    if [ -n "$sc" ]; then
        kubectl get storageclass "$sc" >/dev/null 2>&1 \
            && ok "storageClass $sc" || no "storageClass $sc in contract but not in cluster"
    else
        no "no contract published — cd ../L0 && just {{l0_env}}-up"
    fi

    echo "── 2. Argo CD ────────────────────────────────────"
    for d in argocd-server argocd-repo-server argocd-applicationset-controller; do
        r="$(kubectl -n {{argocd_ns}} get deploy "$d" -o jsonpath='{.status.readyReplicas}' 2>/dev/null)"
        [ "${r:-0}" -ge 1 ] 2>/dev/null && ok "$d" || no "$d not ready"
    done
    r="$(kubectl -n {{argocd_ns}} get statefulset argocd-application-controller -o jsonpath='{.status.readyReplicas}' 2>/dev/null)"
    [ "${r:-0}" -ge 1 ] 2>/dev/null && ok "argocd-application-controller" || no "argocd-application-controller not ready"

    echo "── 3. generators ─────────────────────────────────"
    sets="$(kubectl -n {{argocd_ns}} get applicationsets -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"
    if [ -z "$sets" ]; then
        no "no ApplicationSets — is the root app applied?"
    else
        for s in $sets; do
            err="$(kubectl -n {{argocd_ns}} get applicationset "$s" -o jsonpath='{.status.conditions[?(@.type=="ErrorOccurred")].status}' 2>/dev/null)"
            if [ "$err" = "True" ]; then
                msg="$(kubectl -n {{argocd_ns}} get applicationset "$s" -o jsonpath='{.status.conditions[?(@.type=="ErrorOccurred")].message}' 2>/dev/null)"
                no "appset $s: $msg"
            else
                ok "appset $s generating"
            fi
        done
    fi

    echo "── 4. expected components ────────────────────────"
    # The catalog is the source of truth: every `- component:` in either appset
    # must have produced an Application named <env>-<component>.
    comps="$(grep -hoE '^[[:space:]]+- component: [^[:space:]]+' \
        {{justfile_directory()}}/platform/appset.yaml \
        {{justfile_directory()}}/platform/appset-vendored.yaml | awk '{print $3}' | sort -u)"
    for c in $comps; do
        if kubectl -n {{argocd_ns}} get application "{{l1_env}}-$c" >/dev/null 2>&1; then
            ok "application {{l1_env}}-$c"
        else
            no "application {{l1_env}}-$c MISSING — the generator never produced it"
        fi
    done

    echo "── 5. convergence ────────────────────────────────"
    # Project-scoped, for the reason spelled out above `drift`: L2's
    # Applications share this namespace and are not L1's to pass or fail on.
    rows="$(kubectl -n {{argocd_ns}} get applications \
        -o jsonpath='{range .items[?(@.spec.project=="{{project}}")]}{.metadata.name}{"\t"}{.status.sync.status}{"\t"}{.status.health.status}{"\n"}{end}' 2>/dev/null)"
    if [ -z "$rows" ]; then
        no "no Applications exist at all"
    else
        while IFS=$'\t' read -r n s h; do
            [ -z "$n" ] && continue
            if [ "$s" = "Synced" ] && [ "$h" = "Healthy" ]; then ok "$n"
            else no "$n  ${s:-?}/${h:-?}  — just why $n"; fi
        done <<<"$rows"
    fi

    echo "── 6. capabilities L2 depends on ─────────────────"
    # Deliberately the same four L2/bootstrap/up.sh checks — a capability that
    # is missing should fail here, not one layer up as "no matches for kind".
    crd(){ kubectl get crd "$1" >/dev/null 2>&1 && ok "$2" || no "$2 — CRD $1 absent"; }
    crd externalsecrets.external-secrets.io     "External Secrets (ExternalSecret)"
    crd authorizationpolicies.security.istio.io "Istio (AuthorizationPolicy)"
    crd gateways.gateway.networking.k8s.io      "Gateway API (Gateway)"
    crd certificates.cert-manager.io            "cert-manager (Certificate)"

    echo
    if [ "$fail" -eq 0 ]; then
        echo ">> L1 verified — the platform is up and L2 can bootstrap on it"
    else
        echo "!! L1 is NOT ready. Fix the FAIL lines above, then re-run."
        exit 1
    fi

# Argo buries a failure at four different depths, and the top two are routinely
# empty — a sync rejected by the AppProject shows up as a bare
# "OutOfSync / Missing" with no condition set. This walks all four:
#
#   1. .status.sync / .status.health          the summary `just apps` prints
#   2. the parent ApplicationSet's            an app waiting on an earlier
#      RollingSync step                       wave looks IDENTICAL to a failure
#   3. .status.operationState                 phase + the retry counter
#   4. …syncResult.resources[].message        where the real error actually is
#
# (2) is what stops a false alarm: under RollingSync every app in a later wave
# sits at OutOfSync/Missing by design.
#
# Why is an app unhealthy? `just why dev-local-istiod`
why app:
    #!/usr/bin/env bash
    set -uo pipefail
    export KUBECONFIG="$(just _kubeconfig)"

    json="$(kubectl -n {{argocd_ns}} get application {{app}} -o json 2>/dev/null)" || {
        echo "!! no Application '{{app}}' in {{argocd_ns}} — 'just apps' lists them" >&2; exit 1; }

    # Multi-source apps — every one the appset generates — report a revision per
    # source in .revisions (chart version, then the sha of this repo). Their
    # scalar .revision is empty, so reading only that printed a bare "-".
    jq -r '
        "── \(.metadata.name) " + ("─" * 30),
        "SYNC:     \(.status.sync.status // "-")",
        "HEALTH:   \(.status.health.status // "-")"
            + (if (.status.health.message // "") != "" then "  — \(.status.health.message)" else "" end),
        "REVISION: " + (
            if (.status.sync.revision // "") != "" then .status.sync.revision[0:7]
            elif ((.status.sync.revisions // []) | length) > 0 then
                (.status.sync.revisions
                 | map(if test("^[0-9a-f]{40}$") then .[0:7] else . end)
                 | join("  +  "))
            else "-" end)
    ' <<<"$json"

    owner="$(jq -r '[.metadata.ownerReferences[]? | select(.kind=="ApplicationSet") | .name][0] // ""' <<<"$json")"
    if [ -n "$owner" ]; then
        kubectl -n {{argocd_ns}} get applicationset "$owner" -o json 2>/dev/null \
          | jq -r --arg app '{{app}}' --arg set "$owner" '
            ((.status.applicationStatus // [])[] | select(.application == $app)) // empty
            | "", "ROLLING SYNC  (applicationset \($set))",
              "  step \(.step)  ·  \(.status)",
              "  \(.message)",
              (if .status == "Waiting" then
                 "  NOTE: blocked behind an earlier wave — this is not a failure."
               else empty end)'
    fi

    jq -r '
        (.status.operationState // empty)
        | "", "OPERATION",
          "  \(.phase)\(if (.message // "") != "" then " — " + .message else "" end)",
          "  started \(.startedAt // "-")\(if .finishedAt then "   finished \(.finishedAt)" else "" end)"
    ' <<<"$json"

    jq -r '
        [ (.status.operationState.syncResult.resources // [])[]
          | select(.status != "Synced" and .status != "Running") ] as $bad
        | if ($bad | length) > 0
          then "", "FAILED RESOURCES", ($bad[] | "  \(.status)  \(.kind)/\(.name)\n      \(.message)")
          else empty end
    ' <<<"$json"

    jq -r '
        [ (.status.resources // [])[]
          | select((.health.status // "") | (. != "" and . != "Healthy")) ] as $bad
        | if ($bad | length) > 0
          then "", "UNHEALTHY RESOURCES",
               ($bad[] | "  \(.health.status)  \(.kind)/\(.name)"
                       + (if .health.message then "\n      \(.health.message)" else "" end))
          else empty end
    ' <<<"$json"

    jq -r '
        (.status.conditions // []) as $c
        | if ($c | length) > 0
          then "", "CONDITIONS", ($c[] | "  [\(.type)] \(.message)")
          else empty end
    ' <<<"$json"

# Tail the applicationset controller — where generator errors surface
logs-appset:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} logs -f deploy/argocd-applicationset-controller

# ─── access ────────────────────────────────────────────────────────────────

# Initial Argo admin password
password:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d; echo

# Port-forward the Argo UI -> https://localhost:8080
ui:
    @echo ">> https://localhost:8080  (user: admin, password: just password)"
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} port-forward svc/argocd-server 8080:443

# Point your shell at this env's cluster: `eval $(just env)`
env:
    @echo "export KUBECONFIG=$(just _kubeconfig)"

# ─── operations ────────────────────────────────────────────────────────────

# Force a re-read of Git without waiting for the poll interval
refresh:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} annotate application --all \
        argocd.argoproj.io/refresh=hard --overwrite

# Are progressive (wave-ordered) syncs actually on? They are configured in Git —
# bootstrap/argocd/kustomization.yaml — so this verifies rather than patches.
progressive:
    #!/usr/bin/env bash
    set -euo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    key=$(kubectl -n {{argocd_ns}} get cm argocd-cmd-params-cm \
        -o jsonpath='{.data.applicationsetcontroller\.enable\.progressive\.syncs}' 2>/dev/null || true)
    env=$(kubectl -n {{argocd_ns}} get deploy argocd-applicationset-controller \
        -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name=="ARGOCD_APPLICATIONSET_CONTROLLER_ENABLE_PROGRESSIVE_SYNCS")].name}' 2>/dev/null || true)
    echo "argocd-cmd-params-cm key : ${key:-<unset>}"
    echo "controller reads it      : ${env:-<no env ref — wrong Argo version?>}"
    if [ "${key:-}" = "true" ]; then
        echo ">> progressive syncs ON — RollingSync in platform/appset.yaml is live"
    else
        echo "!! OFF — ordering is retry-with-backoff. The ConfigMap comes from"
        echo "   bootstrap/argocd/kustomization.yaml; is the argocd app synced?"
        exit 1
    fi

# What would the appset generate? Requires the cluster to be up.
render:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} get applications \
        -l platform.maal/stage --show-labels

# Re-vendor the Gateway API CRDs. Keep the tag in sync with the `version`
# field on the gateway-api element in platform/appset-vendored.yaml.
vendor-gateway-api tag="v1.6.1":
    @mkdir -p vendor/gateway-api
    curl -fsSL "https://github.com/kubernetes-sigs/gateway-api/releases/download/{{tag}}/standard-install.yaml" \
        -o vendor/gateway-api/standard-install.yaml
    @echo ">> vendored Gateway API {{tag}} — update appset-vendored.yaml, then commit"

# ─── validation (no cluster needed) ────────────────────────────────────────

# Check every YAML file parses (skips the vendored Argo manifests)
#
# Uses whichever parser the machine has. macOS system python3 ships without
# PyYAML and GitHub runners ship without a guaranteed ruby, so picking one and
# hoping produces a lint that silently "fails" everything — which is worse than
# no lint, because it looks like it ran.
lint:
    #!/usr/bin/env bash
    set -euo pipefail
    if python3 -c 'import yaml' 2>/dev/null; then
        check() { python3 -c 'import sys,yaml; list(yaml.safe_load_all(open(sys.argv[1])))' "$1"; }
    elif command -v ruby >/dev/null 2>&1; then
        check() { ruby -ryaml -e 'YAML.load_stream(File.read(ARGV[0]))' "$1"; }
    else
        echo "!! no YAML parser — install PyYAML (pip install pyyaml) or ruby" >&2; exit 1
    fi
    fail=0
    while IFS= read -r f; do
        check "$f" 2>/dev/null || { echo "!! parse error: $f"; fail=1; }
    done < <(find . -name '*.yaml' -not -path './bootstrap/argocd/*')
    if [ "$fail" -eq 0 ]; then echo ">> all yaml parses"; else exit 1; fi

# Every component in the catalog should have a values file in every env
check-envs:
    #!/usr/bin/env bash
    set -euo pipefail
    comps=$(grep -oE '^\s+- component: \S+' platform/appset.yaml | awk '{print $3}')
    for envfile in envs/*.yaml; do
        e=$(basename "$envfile" .yaml)
        for c in $comps; do
            test -f "envs/$e/$c.yaml" || echo "   missing (chart defaults apply): envs/$e/$c.yaml"
        done
    done
    echo ">> env/component matrix checked"
