# Remote state for L0/aws. Copy to backend.hcl and edit; backend.hcl is
# gitignored because it names a bucket and, by implication, an account.
#
#   tofu init -backend-config=backend.hcl
#
# Create these BEFORE the first init — a state backend cannot bootstrap itself:
#
#   aws s3api create-bucket --bucket maal-tfstate --region me-south-1 \
#     --create-bucket-configuration LocationConstraint=me-south-1
#   aws s3api put-bucket-versioning --bucket maal-tfstate \
#     --versioning-configuration Status=Enabled
#   aws s3api put-public-access-block --bucket maal-tfstate \
#     --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#
# Versioning is not optional: it is the only thing that makes a corrupted or
# truncated state recoverable.

bucket = "maal-tfstate"
key    = "L0/aws/terraform.tfstate"
region = "me-south-1"

encrypt = true

# State locking. S3 native locking (OpenTofu 1.10+/Terraform 1.11+) needs no
# extra infrastructure and is the better default:
use_lockfile = true

# If you are on an older version, drop use_lockfile and use DynamoDB instead —
# create the table with a partition key named `LockID` of type String:
#   dynamodb_table = "maal-tfstate-lock"
