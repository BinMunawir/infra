# L2 — the Maal product layer. Run from the L2 directory.

set shell := ["bash", "-uc"]

argocd_ns := "argocd"
l0_env    := env_var_or_default("L0_ENV", "local")
l2_env    := env_var_or_default("L2_ENV", "dev-local")
contract  := justfile_directory() / ".." / "L0" / l0_env / "contract.json"

# Where the Go service repos live — siblings of the infra repo.
src       := justfile_directory() / ".."  / ".."
cluster   := "maal-local"

_default:
    @just --list --unsorted

_kubeconfig:
    @test -f {{contract}} || { echo "!! L0 '{{l0_env}}' is not up — run: cd ../L0 && just {{l0_env}}-up" >&2; exit 1; }
    @jq -er .kubeconfig {{contract}}

# ─── lifecycle ─────────────────────────────────────────────────────────────

# Verify the contract + L1, then apply the L2 root
up:
    ./bootstrap/up.sh

# Remove L2, leaving L1 and the cluster (destructive; prompts)
down:
    #!/usr/bin/env bash
    set -euo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    read -rp "Remove all L2 apps and services from '$(kubectl config current-context)'? [y/N] " a
    [[ "$a" == "y" || "$a" == "Y" ]] || { echo "aborted"; exit 0; }
    kubectl delete -f root/root-app.yaml --cascade=foreground --ignore-not-found --timeout=300s || true
    kubectl delete -f root/project.yaml --ignore-not-found || true
    echo ">> L2 removed. Databases are external and untouched — this deletes no data."

# ─── images ────────────────────────────────────────────────────────────────

# Build every service image and load it into kind (no registry needed locally)
images: (image "client" "maal/business") (image "ledger" "maal/ledger") (image "maalstream_ph" "maal/stream-ph")

# Build one service image and load it: `just image ledger maal/ledger`
image repo tag:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{src}}/{{repo}}"
    test -d "$dir" || { echo "!! no such service repo: $dir" >&2; exit 1; }
    if [ ! -f "$dir/Dockerfile" ]; then
        echo "!! {{repo}} has no Dockerfile." >&2
        echo "   Copy ledger/Dockerfile and change the ./cmd/<entrypoint> target." >&2
        echo "   The image must put binaries at /app/<name> with WORKDIR /app and" >&2
        echo "   USER 1001 — charts/go-service assumes exactly that layout." >&2
        exit 1
    fi
    docker build -t "{{tag}}:dev" "$dir"
    kind load docker-image "{{tag}}:dev" --name {{cluster}}
    echo ">> loaded {{tag}}:dev into kind/{{cluster}}"
    echo ">> NOTE: the tag did not change, so the Deployment spec did not either."
    echo "   Argo will report Synced and keep the OLD pods. Roll them:"
    echo "     just restart <service>"

# Roll a service's pods onto a freshly loaded image: `just restart maal-business`
#
# Needed because `:dev` is a mutable tag — see the warning in
# charts/go-service/values.yaml. Cloud envs use immutable tags and never need
# this: the values change is what triggers the rollout.
#
# Roll a service's pods onto a freshly loaded image: `just restart maal-business`
restart service:
    #!/usr/bin/env bash
    set -euo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    kubectl -n {{service}} rollout restart deployment -l app.kubernetes.io/name={{service}}
    kubectl -n {{service}} rollout status deployment -l app.kubernetes.io/name={{service}} --timeout=180s

# ─── inspection ────────────────────────────────────────────────────────────

# L2 Applications with sync + health
apps:
    @KUBECONFIG=$(just _kubeconfig) kubectl -n {{argocd_ns}} get applications -l maal/stage -o wide

# Pods across every L2 namespace
status:
    #!/usr/bin/env bash
    set -euo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    kubectl -n {{argocd_ns}} get applications -l maal/stage -o wide
    for ns in maal-temporal maal-keycloak maal-business maal-stream-ph; do
        echo "--- $ns ---"
        kubectl -n "$ns" get pods 2>/dev/null || echo "  (namespace not created yet)"
    done

# Anything in the maal project not Synced+Healthy. Exits non-zero — usable in CI.
#
# SCOPED TO L2's OWN PROJECT, for the mirror of the reason L1's `drift` is
# scoped to `platform`: Argo keeps every layer's Applications in one namespace,
# and L2 has no business failing CI over a broken platform component.
#
# Anything in the maal project not Synced+Healthy. Non-zero exit — CI-usable
drift:
    #!/usr/bin/env bash
    set -uo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    bad=$(kubectl -n {{argocd_ns}} get applications \
        -o jsonpath='{range .items[?(@.spec.project=="maal")]}{.metadata.name}{"\t"}{.status.sync.status}{"\t"}{.status.health.status}{"\n"}{end}' \
        | awk '$2 != "Synced" || $3 != "Healthy"')
    if [ -n "$bad" ]; then
        echo "!! not converged:"; echo "$bad"; exit 1
    fi
    echo ">> all maal Applications Synced + Healthy"

# `drift` asks only "is every Application Synced+Healthy". For L2 that is even
# further from sufficient than it is for L1, because this layer's two hardest
# failure modes are both invisible at that level:
#
#   - Every database is EXTERNAL. A missing database or role does not make an
#     Application red; it makes a schema job retry behind a green one.
#   - A workload parked at `replicas: 0` is legitimately green with no pods, so
#     "no pods running" cannot be read as failure — nor as success.
#
# So this checks, in dependency order:
#
#   1. the L0 contract still holds     L2's env file mirrors it; both must agree
#   2. L1's capabilities are present   same four CRDs bootstrap/up.sh demands
#   3. the generators produced params  where a template error hides
#   4. the expected app matrix         the fail-open case: zero Applications are
#                                      all trivially Synced+Healthy
#   5. every Application Synced+Healthy what `drift` covers
#   6. secrets actually materialised   an ExternalSecret that never resolved
#                                      leaves a workload with no credentials
#   7. workloads at their declared size compares spec.replicas to ready, so a
#                                      parked 0-replica service passes as 0/0
#   8. the routes resolve and answer   accepted by L1's Gateway, backends
#                                      resolved, and a real request through the
#                                      edge comes back. The Gateway and its
#                                      certificate are L1's — `cd ../L1 && just
#                                      verify` covers those.
#
# Does L2 deliver what it promises? Exits non-zero if not — usable in CI.
verify:
    #!/usr/bin/env bash
    set -uo pipefail
    export KUBECONFIG="$(just _kubeconfig)"
    fail=0
    ok(){   printf '  ok    %s\n' "$*"; }
    no(){   printf '  FAIL  %s\n' "$*"; fail=1; }
    note(){ printf '  --    %s\n' "$*"; }

    envfile="{{justfile_directory()}}/envs/{{l2_env}}.yaml"

    echo "── 1. L0 contract ────────────────────────────────"
    sc_actual="$(jq -r .storageClass {{contract}} 2>/dev/null || echo '')"
    sc_env="$(awk '/^contract:/{f=1;next} f&&/storageClass:/{print $2;exit}' "$envfile" | tr -d '"')"
    kubectl get nodes >/dev/null 2>&1 && ok "cluster reachable" || no "cluster unreachable"
    if [ -z "$sc_actual" ]; then
        no "no contract published — cd ../L0 && just {{l0_env}}-up"
    elif [ "$sc_actual" != "$sc_env" ]; then
        no "contract drift: envs/{{l2_env}}.yaml says '$sc_env', L0 published '$sc_actual'"
    else
        ok "storageClass $sc_actual matches envs/{{l2_env}}.yaml"
    fi

    echo "── 2. L1 capabilities ────────────────────────────"
    crd(){ kubectl get crd "$1" >/dev/null 2>&1 && ok "$2" || no "$2 — CRD $1 absent; is L1 converged?"; }
    crd externalsecrets.external-secrets.io     "External Secrets (ExternalSecret)"
    crd authorizationpolicies.security.istio.io "Istio (AuthorizationPolicy)"
    crd httproutes.gateway.networking.k8s.io    "Gateway API (HTTPRoute)"
    kubectl -n {{argocd_ns}} get appproject platform >/dev/null 2>&1 \
        && ok "AppProject platform" || no "AppProject platform missing — run L1's bootstrap first"

    # The two L1 INSTANCES this layer binds to by name, not just the CRDs. Both
    # moved to L1 with the platform/product split, and both fail one layer up in
    # ways that read as an application bug: an ExternalSecret whose store is
    # missing sits Pending forever, and an HTTPRoute whose Gateway is missing
    # reports Accepted=False with no hint that the Gateway is another layer's.
    kubectl get clustersecretstore maal-secret-store >/dev/null 2>&1 \
        && ok "ClusterSecretStore maal-secret-store (L1)" \
        || no "ClusterSecretStore maal-secret-store absent — cd ../L1 && just verify"
    kubectl -n maal-edge get gateway maal-edge >/dev/null 2>&1 \
        && ok "Gateway maal-edge (L1)" \
        || no "Gateway maal-edge absent — cd ../L1 && just verify"

    echo "── 3. generators ─────────────────────────────────"
    # Project-scoped like sections 4 and 5. An ApplicationSet carries the
    # project on its template, not on itself, which is why this path is a level
    # deeper than the one in section 5.
    sets="$(kubectl -n {{argocd_ns}} get applicationsets \
        -o jsonpath='{range .items[?(@.spec.template.spec.project=="maal")]}{.metadata.name}{"\n"}{end}' 2>/dev/null)"
    if [ -z "$sets" ]; then
        no "no ApplicationSets in project maal — is maal-root synced?"
    else
        for s in $sets; do
            err="$(kubectl -n {{argocd_ns}} get applicationset "$s" \
                -o jsonpath='{.status.conditions[?(@.type=="ErrorOccurred")].status}' 2>/dev/null)"
            if [ "$err" = "True" ]; then
                msg="$(kubectl -n {{argocd_ns}} get applicationset "$s" \
                    -o jsonpath='{.status.conditions[?(@.type=="ErrorOccurred")].message}' 2>/dev/null)"
                no "appset $s: $msg"
            else
                ok "appset $s generating"
            fi
        done
    fi

    echo "── 4. expected applications ──────────────────────"
    # The catalogs are the source of truth: every `- app:` and `- service:` must
    # have produced an Application named <env>-<name>. Plus the two singletons
    # the edge and secrets appsets generate, and the root itself.
    apps="$(grep -hoE '^[[:space:]]+- (app|service): [^[:space:]]+' \
        {{justfile_directory()}}/apps/deps-appset.yaml \
        {{justfile_directory()}}/apps/services-appset.yaml | awk '{print $3}' | sort -u)"
    for a in $apps; do
        if kubectl -n {{argocd_ns}} get application "{{l2_env}}-$a" >/dev/null 2>&1; then
            ok "application {{l2_env}}-$a"
        else
            no "application {{l2_env}}-$a MISSING — the generator never produced it"
        fi
    done
    for a in app-secrets routes; do
        kubectl -n {{argocd_ns}} get application "{{l2_env}}-$a" >/dev/null 2>&1 \
            && ok "application {{l2_env}}-$a" || no "application {{l2_env}}-$a MISSING"
    done
    kubectl -n {{argocd_ns}} get application maal-root >/dev/null 2>&1 \
        && ok "application maal-root" || no "application maal-root MISSING — run just up"

    echo "── 5. convergence ────────────────────────────────"
    rows="$(kubectl -n {{argocd_ns}} get applications \
        -o jsonpath='{range .items[?(@.spec.project=="maal")]}{.metadata.name}{"\t"}{.status.sync.status}{"\t"}{.status.health.status}{"\n"}{end}' 2>/dev/null)"
    if [ -z "$rows" ]; then
        no "no Applications exist at all"
    else
        while IFS=$'\t' read -r n s h; do
            [ -z "$n" ] && continue
            if [ "$s" = "Synced" ] && [ "$h" = "Healthy" ]; then ok "$n"
            else no "$n  ${s:-?}/${h:-?}  — just why $n"; fi
        done <<<"$rows"
    fi

    echo "── 6. secrets ────────────────────────────────────"
    # The store itself is L1's and is checked in section 2 — here we only care
    # that this layer's own ExternalSecrets actually resolved against it.
    es="$(kubectl get externalsecrets -A \
        -o jsonpath='{range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\t"}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' 2>/dev/null)"
    if [ -z "$es" ]; then
        no "no ExternalSecrets at all — did the services and secret store sync?"
    else
        while IFS=$'\t' read -r name ready; do
            [ -z "$name" ] && continue
            [ "$ready" = "True" ] && ok "externalsecret $name" \
                || no "externalsecret $name not Ready (${ready:-<no status>}) — is its key in the store?"
        done <<<"$es"
    fi

    echo "── 7. workloads ──────────────────────────────────"
    # spec.replicas vs ready, NOT "are there pods". A service parked at
    # replicas: 0 is supposed to have none, and reading that as a failure is
    # what would make this check untrustworthy on a correct cluster.
    for ns in maal-temporal maal-keycloak maal-business maal-stream-ph; do
        rows="$(kubectl -n "$ns" get deploy,statefulset \
            -o jsonpath='{range .items[*]}{.kind}{"/"}{.metadata.name}{"\t"}{.spec.replicas}{"\t"}{.status.readyReplicas}{"\n"}{end}' 2>/dev/null)"
        if [ -z "$rows" ]; then
            no "namespace $ns has no workloads at all"
            continue
        fi
        while IFS=$'\t' read -r name want got; do
            [ -z "$name" ] && continue
            got="${got:-0}"
            if [ "${want:-0}" -eq 0 ] 2>/dev/null; then
                note "$ns/$name parked at 0 replicas"
            elif [ "$got" -ge "$want" ] 2>/dev/null; then
                ok "$ns/$name $got/$want"
            else
                no "$ns/$name $got/$want ready"
            fi
        done <<<"$rows"
    done

    echo "── 8. the routes ─────────────────────────────────"
    # The Gateway, its listener and its certificate are L1's and were checked in
    # section 2 by existence. What this layer owns is the routing table, so
    # that is what gets verified in depth here.
    #
    # A route can be Accepted and still point at nothing, so both conditions
    # matter: ResolvedRefs=False is the one that means "the backend Service does
    # not exist", which is the common failure after renaming a chart release.
    # Accepted=False, by contrast, usually means the hostname fell outside the
    # wildcard L1's listener bounds — see L2/routes/{{l2_env}}/routes.yaml.
    want_port="$(jq -r '.lbEndpoint | split(":")[1]' {{contract}} 2>/dev/null)"
    routes="$(kubectl get httproute -A \
        -o jsonpath='{range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\t"}{.status.parents[0].conditions[?(@.type=="Accepted")].status}{"\t"}{.status.parents[0].conditions[?(@.type=="ResolvedRefs")].status}{"\n"}{end}' 2>/dev/null)"
    if [ -z "$routes" ]; then
        no "no HTTPRoutes — has {{l2_env}}-routes synced?"
    else
        while IFS=$'\t' read -r name acc res; do
            [ -z "$name" ] && continue
            if [ "$acc" = "True" ] && [ "$res" = "True" ]; then ok "httproute $name"
            elif [ "$acc" != "True" ]; then
                no "httproute $name accepted=${acc:-?} — hostname outside L1's listener wildcard?"
            else
                no "httproute $name resolvedRefs=${res:-?} — backend Service missing?"
            fi
        done <<<"$routes"
    fi

    # The only check here that leaves the cluster and comes back. Everything
    # above can pass while the edge answers nothing, because "Accepted" means
    # istiod took the config, not that a request survives the trip through the
    # kind port mapping, the NodePort, the TLS listener and the route.
    #
    # Hostnames come from the live routes rather than a hardcoded list: this
    # file should not carry a second copy of the routing table that can drift
    # from the one in Git.
    #
    # No --resolve on the first attempt: the hostnames are nip.io names that
    # resolve to 127.0.0.1 through PUBLIC DNS, so this tests exactly what a
    # browser does — lookup included. Faking the lookup would pass on a machine
    # where the browser fails.
    #
    # NOT `$(curl ... || echo 000)`. curl PRINTS the write-out format even when
    # the transfer fails — "000" — and then exits non-zero, so the `||` appends
    # a second "000" and the variable holds "000\n000". That never equals "000",
    # so every unreachable case fell through to the success branch and reported
    # ok. A probe that passes when the thing is down is worse than no probe.
    probe(){ curl -sk --max-time 10 -o /dev/null -w '%{http_code}' "$@" 2>/dev/null || true; }

    hosts="$(kubectl get httproute -A -o jsonpath='{range .items[*]}{range .spec.hostnames[*]}{@}{"\n"}{end}{end}' 2>/dev/null | sort -u)"
    if [ -z "$hosts" ]; then
        note "no route hostnames to probe"
    elif command -v curl >/dev/null 2>&1; then
        for h in $hosts; do
            url="https://$h:${want_port:-8080}/"
            code="$(probe "$url")"; code="${code:-000}"
            if [ "$code" = "000" ]; then
                # Tell "this machine has no DNS" apart from "the edge is down".
                # nip.io is public, so an offline laptop cannot resolve it even
                # though the gateway is perfectly healthy — and reporting that
                # as a broken edge is exactly the false alarm that teaches
                # people to stop trusting this check.
                alt="$(probe --resolve "$h:${want_port:-8080}:127.0.0.1" "$url")"
                case "${alt:-000}" in
                    2*|3*) note "$url answers only with the lookup bypassed — the edge is fine, this machine cannot resolve nip.io (offline?)" ;;
                    *)     no   "$url unreachable — cd ../L1 && just edge-port, then check the gateway pod" ;;
                esac
                continue
            fi
            case "$code" in
                2*|3*) ok "$url -> $code" ;;
                *)     no "$url -> $code" ;;
            esac
        done
    else
        note "edge not probed (no curl)"
    fi

    echo
    if [ "$fail" -eq 0 ]; then
        echo ">> L2 verified — the product layer is up"
    else
        echo "!! L2 is NOT ready. Fix the FAIL lines above, then re-run."
        exit 1
    fi

# ─── the routes ────────────────────────────────────────────────────────────
#
# The Gateway, its TLS listener and its certificate are L1's — `cd ../L1 && just
# edge` for those, and `just edge-port` / `just edge-ca` / `just urls` live
# there too. This layer owns the routing table and nothing else about the edge.

# Which hostnames are wired to which backends, and whether they resolved
routes:
    #!/usr/bin/env bash
    set -euo pipefail
    export KUBECONFIG=$(just _kubeconfig)
    kubectl get httproute -A 2>/dev/null || echo "(no HTTPRoutes yet)"
    echo "--- the gateway they attach to (L1 owns it) ---"
    kubectl -n maal-edge get gateway maal-edge 2>/dev/null \
        || echo "  !! Gateway maal-edge absent — cd ../L1 && just verify"

# Did the secrets actually materialise? (the store itself is L1's)
secrets:
    @KUBECONFIG=$(just _kubeconfig) kubectl get externalsecrets -A 2>/dev/null || echo "(external-secrets CRDs not present — is L1 converged?)"
    @echo "--- the store they read from (L1 owns it) ---"
    @KUBECONFIG=$(just _kubeconfig) kubectl get clustersecretstores 2>/dev/null || true

# Same four-level walk as L1's `why` — see the comment there for why the top
# two levels are usually empty and the real error sits two deeper.
#
# Why is an app unhealthy? `just why dev-local-maal-business`
why app:
    #!/usr/bin/env bash
    set -uo pipefail
    export KUBECONFIG="$(just _kubeconfig)"

    json="$(kubectl -n {{argocd_ns}} get application {{app}} -o json 2>/dev/null)" || {
        echo "!! no Application '{{app}}' in {{argocd_ns}} — 'just apps' lists them" >&2; exit 1; }

    # Multi-source apps report a revision per source in .revisions; their scalar
    # .revision is empty, so reading only that printed a bare "-".
    jq -r '
        "── \(.metadata.name) " + ("─" * 30),
        "SYNC:     \(.status.sync.status // "-")",
        "HEALTH:   \(.status.health.status // "-")"
            + (if (.status.health.message // "") != "" then "  — \(.status.health.message)" else "" end),
        "REVISION: " + (
            if (.status.sync.revision // "") != "" then .status.sync.revision[0:7]
            elif ((.status.sync.revisions // []) | length) > 0 then
                (.status.sync.revisions
                 | map(if test("^[0-9a-f]{40}$") then .[0:7] else . end)
                 | join("  +  "))
            else "-" end)
    ' <<<"$json"

    owner="$(jq -r '[.metadata.ownerReferences[]? | select(.kind=="ApplicationSet") | .name][0] // ""' <<<"$json")"
    if [ -n "$owner" ]; then
        kubectl -n {{argocd_ns}} get applicationset "$owner" -o json 2>/dev/null \
          | jq -r --arg app '{{app}}' --arg set "$owner" '
            ((.status.applicationStatus // [])[] | select(.application == $app)) // empty
            | "", "ROLLING SYNC  (applicationset \($set))",
              "  step \(.step)  ·  \(.status)",
              "  \(.message)",
              (if .status == "Waiting" then
                 "  NOTE: blocked behind an earlier wave — this is not a failure."
               else empty end)'
    fi

    jq -r '
        (.status.operationState // empty)
        | "", "OPERATION",
          "  \(.phase)\(if (.message // "") != "" then " — " + .message else "" end)",
          "  started \(.startedAt // "-")\(if .finishedAt then "   finished \(.finishedAt)" else "" end)"
    ' <<<"$json"

    jq -r '
        [ (.status.operationState.syncResult.resources // [])[]
          | select(.status != "Synced" and .status != "Running") ] as $bad
        | if ($bad | length) > 0
          then "", "FAILED RESOURCES", ($bad[] | "  \(.status)  \(.kind)/\(.name)\n      \(.message)")
          else empty end
    ' <<<"$json"

    jq -r '
        [ (.status.resources // [])[]
          | select((.health.status // "") | (. != "" and . != "Healthy")) ] as $bad
        | if ($bad | length) > 0
          then "", "UNHEALTHY RESOURCES",
               ($bad[] | "  \(.health.status)  \(.kind)/\(.name)"
                       + (if .health.message then "\n      \(.health.message)" else "" end))
          else empty end
    ' <<<"$json"

    jq -r '
        (.status.conditions // []) as $c
        | if ($c | length) > 0
          then "", "CONDITIONS", ($c[] | "  [\(.type)] \(.message)")
          else empty end
    ' <<<"$json"

# ─── validation (no cluster needed) ────────────────────────────────────────

# Render every service through the chart — catches template errors before Argo does
render:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v helm >/dev/null || { echo "!! helm not installed" >&2; exit 1; }
    for f in envs/{{l2_env}}/maal-*.yaml; do
        s=$(basename "$f" .yaml)
        echo "── $s ──"
        helm template "$s" charts/go-service -f "$f" >/dev/null && echo "   ok"
    done

# Lint the local chart
lint:
    @command -v helm >/dev/null || { echo "!! helm not installed" >&2; exit 1; }
    @helm lint charts/go-service

# Every app in the catalogs should have a values file in every env
check-envs:
    #!/usr/bin/env bash
    set -euo pipefail
    apps=$(grep -hoE '^\s+- (service|app): \S+' apps/*.yaml | awk '{print $3}' | sort -u)
    for envfile in envs/*.yaml; do
        e=$(basename "$envfile" .yaml)
        for a in $apps; do
            test -f "envs/$e/$a.yaml" || echo "   missing (chart defaults apply): envs/$e/$a.yaml"
        done
    done
    echo ">> env/app matrix checked"

# Check every YAML parses. See the note in ../L1/justfile about parser choice.
yaml:
    #!/usr/bin/env bash
    set -euo pipefail
    if python3 -c 'import yaml' 2>/dev/null; then
        check() { python3 -c 'import sys,yaml; list(yaml.safe_load_all(open(sys.argv[1])))' "$1"; }
    elif command -v ruby >/dev/null 2>&1; then
        check() { ruby -ryaml -e 'YAML.load_stream(File.read(ARGV[0]))' "$1"; }
    else
        echo "!! no YAML parser — install PyYAML (pip install pyyaml) or ruby" >&2; exit 1
    fi
    fail=0
    while IFS= read -r f; do
        check "$f" 2>/dev/null || { echo "!! parse error: $f"; fail=1; }
    done < <(find . -name '*.yaml' -not -path './charts/*/templates/*')
    if [ "$fail" -eq 0 ]; then echo ">> all yaml parses"; else exit 1; fi
