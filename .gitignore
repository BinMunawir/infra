# ─── credentials — never commit ────────────────────────────────────────────
# L0 emits a kubeconfig per environment; it carries client certs / tokens.
kubeconfig
*.kubeconfig
L0/**/kubeconfig

# Argo CD repo deploy key (read by L1/bootstrap/up.sh from outside the tree,
# but guard against a stray copy landing here).
*.pem
id_ed25519*
*_deploy
*_deploy.pub

# ─── L0 contract artifacts ─────────────────────────────────────────────────
# Generated by `just <env>-up`; describes one live cluster, not the source.
contract.json

# ─── OpenTofu / Terraform ──────────────────────────────────────────────────
# NB: .terraform.lock.hcl is deliberately NOT ignored — commit it. It pins
# provider versions + checksums, which is the whole point of a lock file.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Keep *.tfvars.example; ignore real ones — they carry account ids and CIDRs.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend configuration names a state bucket and, by implication, an account.
# Keep the .example, ignore the real one.
backend.hcl

# ─── local tooling ─────────────────────────────────────────────────────────
.claude/settings.local.json

# ─── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
*.swp