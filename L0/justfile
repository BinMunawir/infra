# L0 — cluster provisioning. Run from the L0 directory (`just -f L0/justfile …`
# or `cd L0 && just …`). See contract.md for what these commands promise.

set shell := ["bash", "-uc"]

_default:
    @just --list --unsorted

# ─── contract ──────────────────────────────────────────────────────────────

# Read one contract field: `just contract local kubeconfig`
contract env field:
    @test -f {{env}}/contract.json || { echo "!! no contract for '{{env}}' — run 'just {{env}}-up'" >&2; exit 1; }
    @jq -er '.{{field}} // empty' {{env}}/contract.json || { echo "!! '{{field}}' is not a contract field" >&2; exit 1; }

# Show the full published contract for an env
show env="local":
    @test -f {{env}}/contract.json && jq . {{env}}/contract.json || echo "no contract for '{{env}}' — not provisioned"

# Which environments are currently provisioned?
status:
    @for e in local aws gcp; do \
        if [ -f "$e/contract.json" ]; then \
            printf '%-6s up    %s\n' "$e" "$(jq -r '.cluster + "  sc=" + .storageClass + "  lb=" + .lbEndpoint' $e/contract.json)"; \
        else \
            printf '%-6s down\n' "$e"; \
        fi; \
    done

# Verify a live cluster still satisfies the contract it published
verify env="local":
    #!/usr/bin/env bash
    set -euo pipefail
    test -f {{env}}/contract.json || { echo "!! no contract for '{{env}}'" >&2; exit 1; }
    KC=$(jq -r .kubeconfig {{env}}/contract.json)
    SC=$(jq -r .storageClass {{env}}/contract.json)
    test -f "$KC" || { echo "!! kubeconfig missing: $KC" >&2; exit 1; }
    kubectl --kubeconfig "$KC" get nodes >/dev/null || { echo "!! cluster unreachable" >&2; exit 1; }
    kubectl --kubeconfig "$KC" get storageclass "$SC" >/dev/null || { echo "!! storageClass '$SC' missing" >&2; exit 1; }
    echo ">> {{env}} satisfies the contract"

# ─── local (kind) ──────────────────────────────────────────────────────────

# Create the kind cluster and publish the contract
local-up:
    ./local/up.sh

# Delete the kind cluster and withdraw the contract (prompts)
local-down:
    ./local/down.sh

# Delete without prompting — for scripts and CI
local-nuke:
    FORCE=1 ./local/down.sh

# Point your shell at the local cluster: `eval $(just local-env)`
local-env:
    @echo "export KUBECONFIG={{justfile_directory()}}/local/kubeconfig"

# Not part of the contract; lbEndpoint stays 127.0.0.1:8080 either way.
# OPTIONAL: run cloud-provider-kind so `type: LoadBalancer` Services get IPs
local-lb:
    #!/usr/bin/env bash
    set -euo pipefail
    if docker ps --format '{{{{.Names}}}}' | grep -qx cloud-provider-kind; then
        echo ">> cloud-provider-kind already running"; exit 0
    fi
    docker run -d --name cloud-provider-kind --network kind \
        -v /var/run/docker.sock:/var/run/docker.sock \
        registry.k8s.io/cloud-provider-kind/cloud-controller-manager:v0.7.0
    echo ">> cloud-provider-kind started — LoadBalancer Services will now get docker-network IPs"

# ─── cloud (OpenTofu) ──────────────────────────────────────────────────────
# Skeletons — see aws/README.md and gcp/README.md before running these.

aws-plan:   (_tf-plan "aws")
aws-up:     (_tf-up "aws")
aws-down:   (_tf-down "aws")

gcp-plan:   (_tf-plan "gcp")
gcp-up:     (_tf-up "gcp")
gcp-down:   (_tf-down "gcp")

# Both cloud implementations declare a partial backend, so init needs the
# bucket details. Fail with the fix rather than silently using local state.
_tf-init env:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{env}}
    if [ ! -f backend.hcl ]; then
        echo "!! {{env}}/backend.hcl is missing — remote state is not configured." >&2
        echo "   cp {{env}}/backend.hcl.example {{env}}/backend.hcl   # then edit" >&2
        echo "   It explains which bucket to create first." >&2
        exit 1
    fi
    tofu init -upgrade -backend-config=backend.hcl

_tf-plan env: (_tf-init env)
    cd {{env}} && tofu plan

# THE TWO-PHASE APPLY, automated.
#
# The `kubernetes` provider in versions.tf is configured from outputs of the
# cluster this module creates, so on empty state OpenTofu cannot plan the
# StorageClass — it has no endpoint to talk to yet. Phase 1 builds the cluster;
# phase 2 does everything else.
#
# This is scripted rather than documented because a `-target` you have to
# remember is a `-target` you forget at 2am. `-target` is otherwise a smell:
# it is used here exactly once, for provider bootstrapping, and never to work
# around a broken dependency graph.
#
# The alternative — splitting the StorageClass into its own root module — is
# cleaner and costs a second state file and a second init. Worth doing if this
# module grows other cluster-scoped resources.
_tf-up env: (_tf-init env)
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{env}}
    if ! tofu state list >/dev/null 2>&1 || [ -z "$(tofu state list 2>/dev/null)" ]; then
        echo ">> empty state — phase 1: the cluster only"
        case "{{env}}" in
            aws) tofu apply -target=module.vpc -target=module.eks ;;
            gcp) tofu apply -target=google_container_cluster.this -target=google_container_node_pool.default ;;
        esac
        echo ">> phase 2: everything else"
    fi
    tofu apply
    # Publish the contract from tofu outputs — same three keys as local.
    tofu output -json \
      | jq '{provider, cluster, kubeconfig, storageClass, lbEndpoint} | map_values(.value)' \
      > contract.json
    echo ">> {{env}} contract published"
    jq . contract.json

_tf-down env: (_tf-init env)
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{env}}
    tofu destroy
    rm -f contract.json kubeconfig
    echo ">> {{env}} contract withdrawn"

# ─── validation (no cloud credentials needed) ──────────────────────────────

# Formatting + syntax on both cloud implementations
fmt:
    @tofu fmt -recursive -check -diff aws gcp

validate:
    #!/usr/bin/env bash
    set -euo pipefail
    for e in aws gcp; do
        echo "── $e ──"
        # -backend=false: validation needs no bucket and no credentials.
        (cd "$e" && tofu init -backend=false -upgrade >/dev/null && tofu validate)
    done
